  "components": [
    {
      "name": "Prominent Button",
      "kind": "button",
      "refersTo": "button-prominent",
      "description": "The single main action in a panel. Ink, never magenta.",
      "html": "<button class=\"ds-btn-prominent\">Start step</button>",
      "css": ".ds-btn-prominent{display:inline-flex;align-items:center;justify-content:center;padding:0 12px;border:2px solid transparent;border-radius:999px;cursor:pointer;transition:transform .16s ease-out,background .16s;font-family:Inter,sans-serif;font-size:13px;font-weight:500;line-height:1.25;height:44px;background:#1B1F27;color:#F2F5FA;} .ds-btn-prominent:active{transform:scale(.97);transition:none} .ds-btn-prominent:focus-visible{outline:none;border-color:#1A67AD}"
