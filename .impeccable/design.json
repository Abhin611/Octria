      "css": ".ds-phase{width:150px;height:116px;box-sizing:border-box;padding:10px 12px;border-radius:16px;background:linear-gradient(rgba(255,255,255,.9),rgba(255,255,255,.72));border:3px solid #C2187A} .ds-phase-name{margin-top:8px;font-family:Inter,sans-serif;font-size:13px;font-weight:600;line-height:1.25;color:#1B1F27} .ds-phase-count{margin-top:3px;font-family:Inter,sans-serif;font-size:12px;font-weight:500;line-height:1.25;font-variant-numeric:tabular-nums;color:#474E5C}"
