      "html": "<ul class=\"ds-marks\"><li><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"9\" r=\"8\" fill=\"#F2F5FA\" stroke=\"#1B1F27\" stroke-width=\"1.76\"/></svg><span>Ready to start</span></li><li><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"9\" r=\"8\" fill=\"#F2F5FA\"/><path d=\"M9 1A8 8 0 0 1 9 17Z\" fill=\"#1A67AD\"/><circle cx=\"9\" cy=\"9\" r=\"8\" fill=\"none\" stroke=\"#1A67AD\" stroke-width=\"1.76\"/></svg><span>In progress</span></li><li><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"9\" r=\"8\" fill=\"#F2F5FA\" stroke=\"#1A67AD\" stroke-width=\"1.76\"/><circle cx=\"9\" cy=\"9\" r=\"4\" fill=\"#1A67AD\"/></svg><span>In review</span></li><li><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"9\" r=\"8\" fill=\"#1F7F4C\"/><path d=\"M5.6 9.2 8.2 11.7 12.7 6.4\" fill=\"none\" stroke=\"#F2F5FA\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>Done</span></li><li><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"9\" r=\"8\" fill=\"#F2F5FA\" stroke=\"#7E8494\" stroke-width=\"1.2\"/><circle cx=\"9\" cy=\"9\" r=\"1.4\" fill=\"#7E8494\"/></svg><span>Waiting on another step</span></li><li><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"9\" r=\"8\" fill=\"#F2F5FA\" stroke=\"#CE2F26\" stroke-width=\"1.76\"/><line x1=\"3.6\" y1=\"3.6\" x2=\"14.4\" y2=\"14.4\" stroke=\"#CE2F26\" stroke-width=\"1.76\"/></svg><span>Blocked by an overdue step</span></li></ul>",
      "css": ".ds-marks{list-style:none;margin:0;padding:0;display:grid;gap:8px} .ds-marks li{display:flex;align-items:center;gap:10px;font-family:Inter,sans-serif;font-size:13px;font-weight:500;line-height:1.25;color:#1B1F27}"
